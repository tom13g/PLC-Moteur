    {
        "id": "fncalcul",
        "type": "function",
        "z": "f10w0001",
        "name": "Calculs (phase, accélération, compteurs)",
        "func": "// Entrées : topics \"coil\", \"reglages\" et \"vitesse\" (lectures Modbus).\n// Sortie 1 : objet complet pour le synoptique, les réglages et les détails.\n// Sortie 2 : vitesse seule pour la jauge et la courbe.\n// On ne transmet jamais le message Modbus d'origine : il contient un tampon\n// binaire que le dashboard ne supporte pas.\nconst VITESSE_NOMINALE = 1500;   // tr/min, pleine échelle\nconst now = Date.now();\n\nif (msg.topic === \"coil\") {\n    // Ordre des coils : voir modbus_map.py\n    context.set(\"coils\", { marche: !!msg.payload[0], au: !!msg.payload[1], manuel: !!msg.payload[2] });\n    return null;\n}\nif (msg.topic === \"reglages\") {\n    context.set(\"reglages\", { consigne: msg.payload[0], montee: msg.payload[1], descente: msg.payload[2] });\n    return null;\n}\n\nconst vitesse = msg.payload[0];\nconst consigne = msg.payload[1];\nconst { marche, au, manuel } = context.get(\"coils\") || { marche: false, au: false, manuel: false };\n\n// Accélération : pente sur la dernière seconde (lisse l'échantillonnage à 0,2 s)\nlet hist = (context.get(\"hist\") || []).filter(p => now - p.t <= 1200);\nhist.push({ t: now, v: vitesse });\ncontext.set(\"hist\", hist);\nconst dt = (now - hist[0].t) / 1000;\nconst acceleration = dt >= 0.4 ? Math.round((vitesse - hist[0].v) / dt) : 0;\n\n// Compteurs tenus par l'IHM (remis à zéro au redémarrage de Node-RED)\nconst s = context.get(\"stats\") || { demarrages: 0, urgences: 0, tempsMarche: 0, dernier: now, marchePrec: false, auPrec: false, vmax: 0 };\nconst ecoule = (now - s.dernier) / 1000;\nif (marche && !s.marchePrec) { s.demarrages++; }\nif (au && !s.auPrec) { s.urgences++; }\nif (s.marchePrec && ecoule < 2) { s.tempsMarche += ecoule; }\ns.vmax = Math.max(s.vmax, vitesse);\ns.marchePrec = marche;\ns.auPrec = au;\ns.dernier = now;\ncontext.set(\"stats\", s);\n\nlet phase = \"ARRET\";\nif (au) { phase = \"URGENCE\"; }\nelse if (vitesse < consigne) { phase = \"ACCELERATION\"; }\nelse if (vitesse > consigne) { phase = \"DECELERATION\"; }\nelse if (marche) { phase = \"REGIME\"; }\n\nconst etat = {\n    marche, au, manuel, vitesse, consigne, phase, acceleration,\n    reglages: context.get(\"reglages\") || null,\n    pourcent: Math.round(100 * vitesse / VITESSE_NOMINALE),\n    nominale: VITESSE_NOMINALE,\n    demarrages: s.demarrages,\n    urgences: s.urgences,\n    tempsMarche: Math.round(s.tempsMarche),\n    vmax: s.vmax,\n    horodatage: now\n};\nreturn [{ topic: \"etat\", payload: etat }, { topic: \"Vitesse (tr/min)\", payload: vitesse }];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 480,
        "y": 280,
        "wires": [
            [
                "tplsynop",
                "tplregla",
                "tpldetai"
            ],
