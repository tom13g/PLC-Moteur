    {
        "id": "fnecrit1",
        "type": "function",
        "z": "f10w0001",
        "name": "Table d'écriture (ordre -> adresse Modbus)",
        "func": "// Traduit les ordres de l'IHM en écritures Modbus.\n// Seul endroit du flow où figurent les adresses d'écriture : elles doivent\n// rester identiques à celles de src/tp_simu_auto/modbus_map.py.\nconst FC_COIL = 5, FC_REGISTRE = 6, ESCLAVE = 1;\nconst TABLE = {\n    marche:         { fc: FC_COIL,     address: 0 },   // CO_MOTEUR\n    urgence:        { fc: FC_COIL,     address: 1 },   // CO_ARRET_URGENCE\n    manuel:         { fc: FC_COIL,     address: 2 },   // CO_MODE_MANUEL\n    consigne:       { fc: FC_REGISTRE, address: 0 },   // HR_CONSIGNE_MANUELLE\n    rampe_montee:   { fc: FC_REGISTRE, address: 1 },   // HR_RAMPE_MONTEE\n    rampe_descente: { fc: FC_REGISTRE, address: 2 }    // HR_RAMPE_DESCENTE\n};\nconst cible = TABLE[msg.topic];\nif (!cible) { node.warn(\"Ordre inconnu : \" + msg.topic); return null; }\n\nlet value;\nif (cible.fc === FC_COIL) {\n    value = msg.payload === true;\n} else {\n    value = Math.round(Number(msg.payload));\n    if (!(value >= 0 && value <= 65535)) { node.warn(\"Valeur refusée pour \" + msg.topic + \" : \" + msg.payload); return null; }\n}\nreturn { payload: { value, fc: cible.fc, unitid: ESCLAVE, address: cible.address, quantity: 1 } };",
