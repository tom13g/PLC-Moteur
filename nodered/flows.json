    {
        "id": "tplregla",
        "type": "ui-template",
        "z": "f10w0001",
        "group": "uigrpreg",
        "page": "",
        "ui": "",
        "name": "Réglages (curseurs)",
        "order": 1,
        "width": 5,
        "height": 5,
        "head": "",
        "format": "<template>\n  <div class=\"reg\">\n    <div class=\"reg-row\" v-for=\"r in lignes\" :key=\"r.cle\">\n      <div class=\"reg-head\">\n        <label :for=\"'reg-' + r.cle\">{{ r.titre }}</label>\n        <output>{{ local[r.cle] }}<small> {{ r.unite }}</small></output>\n      </div>\n      <input type=\"range\" :id=\"'reg-' + r.cle\" :class=\"'s-' + r.cle\" :min=\"r.min\" :max=\"r.max\" :step=\"r.pas\" :disabled=\"!pret\"\n             v-model.number=\"local[r.cle]\" @input=\"toucher(r.cle)\" @change=\"envoyer(r)\">\n      <div class=\"reg-foot\"><span>{{ r.min }}</span><em>{{ r.aide }}</em><span>{{ r.max }}</span></div>\n    </div>\n    <div class=\"reg-actions\">\n      <button class=\"b-defaut\" :disabled=\"!pret\" @click=\"defauts\">Valeurs par défaut</button>\n      <span>{{ pret ? 'Valeurs relues dans l\\'automate' : 'En attente de l\\'automate...' }}</span>\n    </div>\n  </div>\n</template>\n\n<script>\nexport default {\n  data () {\n    return {\n      pret: false,\n      manuel: false,\n      local: { consigne: 750, montee: 300, descente: 150 },\n      touche: { consigne: 0, montee: 0, descente: 0 }\n    }\n  },\n  computed: {\n    lignes () {\n      return [\n        { cle: 'consigne', topic: 'consigne', titre: 'Consigne de vitesse (mode manuel)', unite: 'tr/min', min: 0, max: 1500, pas: 10, defaut: 750,\n          aide: this.manuel ? 'appliquée : mode manuel actif' : 'sans effet en mode auto (1500 tr/min)' },\n        { cle: 'montee', topic: 'rampe_montee', titre: 'Rampe d\\'accélération', unite: 'tr/min/s', min: 50, max: 3000, pas: 50, defaut: 300, aide: this.duree(this.local.montee) },\n        { cle: 'descente', topic: 'rampe_descente', titre: 'Rampe de décélération', unite: 'tr/min/s', min: 50, max: 3000, pas: 50, defaut: 150, aide: this.duree(this.local.descente) }\n      ]\n    }\n  },\n  watch: {\n    msg (m) {\n      if (!m || m.topic !== 'etat' || !m.payload.reglages) return\n      this.manuel = m.payload.manuel\n      this.pret = true\n      // La valeur de l'automate fait foi, sauf pendant qu'on manipule le curseur.\n      const maintenant = Date.now()\n      for (const cle of ['consigne', 'montee', 'descente']) {\n        if (maintenant - this.touche[cle] > 1500) this.local[cle] = m.payload.reglages[cle]\n      }\n    }\n  },\n  methods: {\n    duree (rampe) { return '0 à 1500 tr/min en ' + (1500 / rampe).toFixed(1).replace('.', ',') + ' s' },\n    toucher (cle) { this.touche[cle] = Date.now() },\n    envoyer (r) { this.toucher(r.cle); this.send({ topic: r.topic, payload: this.local[r.cle] }) },\n    defauts () { for (const r of this.lignes) { this.local[r.cle] = r.defaut; this.envoyer(r) } }\n  }\n}\n</script>\n\n<style>\n.reg { color: #e6ebf5; display: flex; flex-direction: column; gap: 14px; }\n.reg-head { display: flex; justify-content: space-between; align-items: baseline; }\n.reg-head label { color: #8a97b1; font-size: 12px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; }\n.reg-head output { font-size: 22px; font-weight: 800; font-variant-numeric: tabular-nums; }\n.reg-head small { margin-left: 4px; font-size: 12px; font-weight: 600; color: #8a97b1; }\n.reg input[type=range] { -webkit-appearance: none; appearance: none; width: 100%; height: 8px; border-radius: 4px; background: #1d2a44; outline: none; margin: 8px 0 4px; }\n.reg input[type=range]::-webkit-slider-thumb { -webkit-appearance: none; width: 22px; height: 22px; border-radius: 50%; background: #22d3ee; border: 3px solid #0b1220; box-shadow: 0 0 0 1px #22d3ee; cursor: pointer; }\n.reg input[type=range]::-moz-range-thumb { width: 18px; height: 18px; border-radius: 50%; background: #22d3ee; border: 3px solid #0b1220; cursor: pointer; }\n.reg input[type=range]:disabled { opacity: .4; }\n.reg-foot { display: flex; justify-content: space-between; color: #8a97b1; font-size: 11px; } .reg-foot em { font-style: normal; color: #e6ebf5; opacity: .8; }\n.reg-actions { display: flex; align-items: center; gap: 12px; color: #8a97b1; font-size: 11px; }\n.b-defaut { padding: 8px 14px; border-radius: 8px; border: 1px solid #24324d; background: #0e1626; color: #e6ebf5; font-family: inherit; font-size: 12px; font-weight: 700; cursor: pointer; }\n.b-defaut:hover:enabled { border-color: #22d3ee; color: #22d3ee; } .b-defaut:disabled { opacity: .4; cursor: not-allowed; }\n</style>",
