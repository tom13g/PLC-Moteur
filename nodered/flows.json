    {
        "id": "tpldetai",
        "type": "ui-template",
        "z": "f10w0001",
        "group": "uigrpdet",
        "page": "",
        "ui": "",
        "name": "Tuiles de détails",
        "order": 1,
        "width": 7,
        "height": 5,
        "head": "",
        "format": "<template>\n  <div class=\"det\">\n    <div class=\"tile\" v-for=\"t in tuiles\" :key=\"t.titre\">\n      <div class=\"tile-h\">{{ t.titre }}</div>\n      <div class=\"tile-v\" :style=\"{color: t.couleur}\">{{ t.valeur }}<small v-if=\"t.unite\"> {{ t.unite }}</small></div>\n      <div class=\"tile-s\">{{ t.detail }}</div>\n    </div>\n  </div>\n</template>\n\n<script>\nexport default {\n  data () { return { e: null } },\n  watch: { msg (m) { if (m && m.topic === 'etat') this.e = m.payload } },\n  computed: {\n    tuiles () {\n      const e = this.e || { marche: false, au: false, manuel: false, vitesse: 0, consigne: 0, pourcent: 0, acceleration: 0, demarrages: 0, urgences: 0, tempsMarche: 0, vmax: 0, nominale: 1500 }\n      const duree = s => String(Math.floor(s / 3600)).padStart(2, '0') + ':' + String(Math.floor(s % 3600 / 60)).padStart(2, '0') + ':' + String(s % 60).padStart(2, '0')\n      const signe = e.acceleration > 0 ? '+' : ''\n      return [\n        { titre: 'Commande', valeur: e.au ? 'URGENCE' : (e.marche ? 'MARCHE' : 'ARRÊT'), couleur: e.au ? '#ef4444' : (e.marche ? '#22c55e' : '#8a97b1'), detail: 'Coils 0 et 1' },\n        { titre: 'Mode', valeur: e.manuel ? 'MANUEL' : 'AUTO', couleur: '#22d3ee', detail: 'Coil 2' },\n        { titre: 'Consigne suivie', valeur: e.consigne, unite: 'tr/min', couleur: '#f59e0b', detail: 'Input register 1' },\n        { titre: 'Vitesse mesurée', valeur: Math.round(e.vitesse), unite: 'tr/min', couleur: '#e6ebf5', detail: 'Input register 0, ' + e.pourcent + ' % du nominal' },\n        { titre: 'Accélération', valeur: signe + e.acceleration, unite: 'tr/min/s', couleur: e.acceleration > 0 ? '#f59e0b' : (e.acceleration < 0 ? '#22d3ee' : '#8a97b1'), detail: 'Calculée sur 1 s' },\n        { titre: 'Vitesse max atteinte', valeur: Math.round(e.vmax), unite: 'tr/min', couleur: '#e6ebf5', detail: 'Depuis le lancement de l\\'IHM' },\n        { titre: 'Temps de marche', valeur: duree(e.tempsMarche), couleur: '#e6ebf5', detail: 'Depuis le lancement de l\\'IHM' },\n        { titre: 'Démarrages', valeur: e.demarrages, couleur: '#e6ebf5', detail: 'Arrêts d\\'urgence : ' + e.urgences }\n      ]\n    }\n  }\n}\n</script>\n\n<style>\n.det { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }\n@media (max-width: 1100px) { .det { grid-template-columns: repeat(2, minmax(0, 1fr)); } }\n.tile { background: #0e1626; border: 1px solid #24324d; border-radius: 10px; padding: 12px 14px; min-width: 0; }\n.tile-h { color: #8a97b1; font-size: 11px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; }\n.tile-v { font-size: 22px; font-weight: 800; line-height: 1.35; font-variant-numeric: tabular-nums; white-space: nowrap; }\n.tile-v small { margin-left: 3px; font-size: 12px; font-weight: 600; color: #8a97b1; }\n.tile-s { color: #8a97b1; font-size: 11px; }\n</style>",
