        "format": "/* Thème sombre de l'IHM */\n.v-application, .nrdb-layout, .v-main { background: #0b1220 !important; color: #e6ebf5; }\n.v-app-bar.v-toolbar { background: #0e1626 !important; color: #e6ebf5 !important; border-bottom: 1px solid #24324d; }\n.nrdb-ui-group .v-card { background: #131c2e !important; color: #e6ebf5 !important; border: 1px solid #24324d !important; border-radius: 12px !important; box-shadow: none !important; }\n.nrdb-ui-group .v-card-title { color: #8a97b1; font-size: 12px !important; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; }\n.nrdb-ui-gauge text, .nrdb-ui-gauge .nrdb-ui-gauge-value, .nrdb-ui-gauge-title { fill: #e6ebf5; color: #e6ebf5; }\n.nrdb-ui-gauge .nrdb-ui-gauge-limits, .nrdb-ui-gauge label { color: #8a97b1; fill: #8a97b1; }",
