    {
        "id": "tplsynop",
        "type": "ui-template",
        "z": "f10w0001",
        "group": "uigrpcmd",
        "page": "",
        "ui": "",
        "name": "Synoptique + commandes",
        "order": 1,
        "width": 5,
        "height": 11,
        "head": "",
        "format": "<template>\n  <div class=\"syn\" :class=\"{'syn-au': e.au && !perdu}\">\n    <div class=\"syn-top\">\n      <div class=\"syn-link\" :class=\"{ko: perdu}\">\n        <span class=\"dot\"></span>{{ perdu ? 'Liaison automate perdue' : 'Liaison automate OK' }}\n      </div>\n      <div class=\"syn-time\">{{ heure }}</div>\n    </div>\n\n    <div class=\"syn-alarm\" v-if=\"e.au && !perdu\">&#9888; ARRÊT D'URGENCE ENCLENCHÉ</div>\n\n    <svg class=\"syn-svg\" viewBox=\"0 0 360 180\" role=\"img\" aria-label=\"Moteur asynchrone\">\n      <rect x=\"70\" y=\"148\" width=\"190\" height=\"10\" rx=\"3\" class=\"m-base\"/>\n      <rect x=\"92\" y=\"136\" width=\"26\" height=\"14\" class=\"m-base\"/><rect x=\"212\" y=\"136\" width=\"26\" height=\"14\" class=\"m-base\"/>\n      <rect x=\"80\" y=\"42\" width=\"170\" height=\"96\" rx=\"14\" class=\"m-body\" :class=\"{on: e.marche, au: e.au}\"/>\n      <g class=\"m-fins\"><line v-for=\"i in 9\" :key=\"i\" :x1=\"92 + i*15\" y1=\"48\" :x2=\"92 + i*15\" y2=\"132\"/></g>\n      <rect x=\"140\" y=\"20\" width=\"50\" height=\"26\" rx=\"4\" class=\"m-box\"/>\n      <circle cx=\"152\" cy=\"33\" r=\"3\" class=\"m-led\" :class=\"{on: e.marche, au: e.au}\"/>\n      <text x=\"162\" y=\"37\" class=\"m-boxtxt\">3~</text>\n      <rect x=\"40\" y=\"52\" width=\"44\" height=\"76\" rx=\"10\" class=\"m-cap\"/>\n      <g :transform=\"'rotate(' + angle + ' 62 90)'\">\n        <g v-for=\"k in 6\" :key=\"k\" :transform=\"'rotate(' + (k*60) + ' 62 90)'\">\n          <path d=\"M62 90 L58 62 Q62 56 66 62 Z\" class=\"m-blade\" :class=\"{on: e.vitesse > 0}\"/>\n        </g>\n        <circle cx=\"62\" cy=\"90\" r=\"6\" class=\"m-hub\"/>\n      </g>\n      <rect x=\"250\" y=\"82\" width=\"46\" height=\"16\" class=\"m-shaft\"/>\n      <g :transform=\"'rotate(' + angle + ' 310 90)'\">\n        <circle cx=\"310\" cy=\"90\" r=\"22\" class=\"m-coupling\" :class=\"{on: e.vitesse > 0}\"/>\n        <line x1=\"310\" y1=\"70\" x2=\"310\" y2=\"110\" class=\"m-mark\"/><line x1=\"290\" y1=\"90\" x2=\"330\" y2=\"90\" class=\"m-mark\"/>\n        <circle cx=\"310\" cy=\"90\" r=\"5\" class=\"m-hub\"/>\n      </g>\n      <text x=\"165\" y=\"98\" class=\"m-label\">M1</text>\n      <text x=\"165\" y=\"116\" class=\"m-sub\">moteur asynchrone</text>\n    </svg>\n\n    <div class=\"syn-phase\" :class=\"'ph-' + (perdu ? 'PERDU' : e.phase)\">{{ libelle }}</div>\n    <div class=\"syn-speed\"><b>{{ perdu ? '---' : Math.round(e.vitesse) }}</b><span>tr/min</span></div>\n    <div class=\"syn-cons\">Consigne suivie : <b>{{ perdu ? '---' : e.consigne }}</b> tr/min</div>\n    <div class=\"syn-bar\"><i :style=\"{width: (perdu ? 0 : e.pourcent) + '%'}\"></i><u :style=\"{left: (perdu ? 0 : Math.round(100 * e.consigne / 1500)) + '%'}\"></u></div>\n\n    <div class=\"syn-mode\">\n      <span>Mode</span>\n      <button class=\"b-auto\" :class=\"{act: !e.manuel && !perdu}\" :disabled=\"perdu\" @click=\"ordre('manuel', false)\">AUTO</button>\n      <button class=\"b-manu\" :class=\"{act: e.manuel && !perdu}\" :disabled=\"perdu\" @click=\"ordre('manuel', true)\">MANUEL</button>\n    </div>\n\n    <div class=\"syn-btns\">\n      <button class=\"b-on\" :class=\"{act: e.marche}\" :disabled=\"perdu || e.au\" @click=\"ordre('marche', true)\">&#9654; MARCHE</button>\n      <button class=\"b-off\" :class=\"{act: !e.marche && !perdu}\" :disabled=\"perdu\" @click=\"ordre('marche', false)\">&#9632; ARRÊT</button>\n    </div>\n\n    <button v-if=\"!e.au\" class=\"b-au\" :disabled=\"perdu\" @click=\"ordre('urgence', true)\"><span>ARRÊT<br>D'URGENCE</span></button>\n    <button v-else class=\"b-rearm\" :disabled=\"perdu\" @click=\"ordre('urgence', false)\">&#8635; RÉARMER L'ARRÊT D'URGENCE</button>\n  </div>\n</template>\n\n<script>\nexport default {\n  data () {\n    return { e: { marche: false, au: false, manuel: false, vitesse: 0, consigne: 0, phase: 'ARRET', pourcent: 0 }, recu: 0, now: Date.now(), angle: 0, raf: null, tick: null, prev: 0 }\n  },\n  computed: {\n    perdu () { return this.now - this.recu > 2000 },\n    heure () { return this.recu ? new Date(this.recu).toLocaleTimeString('fr-FR') : '--:--:--' },\n    libelle () {\n      if (this.perdu) return 'HORS LIGNE'\n      return { ARRET: 'À L\\'ARRÊT', ACCELERATION: 'ACCÉLÉRATION', REGIME: 'RÉGIME ÉTABLI', DECELERATION: 'DÉCÉLÉRATION', URGENCE: 'ARRÊT D\\'URGENCE' }[this.e.phase]\n    }\n  },\n  watch: {\n    msg (m) { if (m && m.topic === 'etat') { this.e = m.payload; this.recu = Date.now() } }\n  },\n  methods: {\n    ordre (topic, payload) { this.send({ topic: topic, payload: payload }) },\n    animer (t) {\n      const dt = this.prev ? (t - this.prev) / 1000 : 0\n      this.prev = t\n      // Rotation ralentie pour rester visible : 1500 tr/min = 1,5 tour/s à l'écran\n      if (!this.perdu) this.angle = (this.angle + 540 * (this.e.vitesse / 1500) * dt) % 360\n      this.raf = requestAnimationFrame(this.animer)\n    }\n  },\n  mounted () {\n    this.tick = setInterval(() => { this.now = Date.now() }, 500)\n    this.raf = requestAnimationFrame(this.animer)\n  },\n  unmounted () { clearInterval(this.tick); cancelAnimationFrame(this.raf) }\n}\n</script>\n\n<style>\n.syn { color: #e6ebf5; display: flex; flex-direction: column; gap: 10px; }\n.syn button { font-family: inherit; cursor: pointer; }\n.syn button:disabled { opacity: .35; cursor: not-allowed; }\n.syn-top { display: flex; justify-content: space-between; align-items: center; font-size: 13px; }\n.syn-link { display: flex; align-items: center; gap: 8px; color: #22c55e; font-weight: 600; }\n.syn-link .dot { width: 10px; height: 10px; border-radius: 50%; background: #22c55e; box-shadow: 0 0 8px #22c55e; }\n.syn-link.ko { color: #ef4444; } .syn-link.ko .dot { background: #ef4444; box-shadow: 0 0 8px #ef4444; }\n.syn-time { color: #8a97b1; font-variant-numeric: tabular-nums; }\n.syn-alarm { text-align: center; padding: 8px; border-radius: 8px; background: #ef4444; color: #fff; font-weight: 800; letter-spacing: 1.5px; animation: syn-blink 1s steps(2, start) infinite; }\n@keyframes syn-blink { to { background: #7f1d1d; } }\n.syn-svg { width: 100%; max-height: 200px; }\n.m-base { fill: #2a3752; } .m-shaft { fill: #9aa7bf; }\n.m-body { fill: #1d2a44; stroke: #3a4a6b; stroke-width: 2; transition: stroke .3s, filter .3s; }\n.m-body.on { stroke: #22d3ee; filter: drop-shadow(0 0 6px rgba(34,211,238,.55)); }\n.m-body.au { stroke: #ef4444; filter: drop-shadow(0 0 6px rgba(239,68,68,.6)); }\n.m-fins line { stroke: #2f3f60; stroke-width: 3; }\n.m-box { fill: #24324d; stroke: #3a4a6b; } .m-boxtxt { fill: #8a97b1; font-size: 12px; font-weight: 700; }\n.m-led { fill: #475674; } .m-led.on { fill: #22c55e; filter: drop-shadow(0 0 4px #22c55e); } .m-led.au { fill: #ef4444; filter: drop-shadow(0 0 4px #ef4444); }\n.m-cap { fill: #16213a; stroke: #3a4a6b; stroke-width: 2; }\n.m-blade { fill: #50618a; } .m-blade.on { fill: #22d3ee; }\n.m-hub { fill: #cbd5e6; }\n.m-coupling { fill: #1d2a44; stroke: #50618a; stroke-width: 4; } .m-coupling.on { stroke: #22d3ee; }\n.m-mark { stroke: #7f8eac; stroke-width: 3; }\n.m-label { fill: #e6ebf5; font-size: 22px; font-weight: 800; text-anchor: middle; }\n.m-sub { fill: #8a97b1; font-size: 10px; text-anchor: middle; letter-spacing: 1px; text-transform: uppercase; }\n.syn-phase { align-self: center; padding: 5px 16px; border-radius: 999px; font-size: 13px; font-weight: 800; letter-spacing: 1.5px; border: 1px solid currentColor; color: #8a97b1; }\n.syn-phase.ph-ACCELERATION { color: #f59e0b; } .syn-phase.ph-REGIME { color: #22c55e; } .syn-phase.ph-DECELERATION { color: #22d3ee; } .syn-phase.ph-URGENCE { color: #ef4444; }\n.syn-speed { text-align: center; line-height: 1; }\n.syn-speed b { font-size: 54px; font-weight: 800; font-variant-numeric: tabular-nums; }\n.syn-speed span { margin-left: 8px; color: #8a97b1; font-size: 16px; }\n.syn-cons { text-align: center; color: #8a97b1; font-size: 13px; } .syn-cons b { color: #e6ebf5; font-variant-numeric: tabular-nums; }\n.syn-bar { position: relative; height: 8px; border-radius: 4px; background: #1d2a44; }\n.syn-bar i { display: block; height: 100%; border-radius: 4px; background: linear-gradient(90deg, #22d3ee, #22c55e); transition: width .2s linear; }\n.syn-bar u { position: absolute; top: -4px; width: 3px; height: 16px; margin-left: -1px; background: #f59e0b; border-radius: 2px; transition: left .2s linear; }\n.syn-mode { display: grid; grid-template-columns: auto 1fr 1fr; align-items: center; gap: 0; margin-top: 4px; }\n.syn-mode span { color: #8a97b1; font-size: 12px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; margin-right: 12px; }\n.syn-mode button { padding: 9px 0; font-size: 13px; font-weight: 800; letter-spacing: 1px; background: #0e1626; color: #8a97b1; border: 1px solid #24324d; }\n.syn-mode .b-auto { border-radius: 8px 0 0 8px; } .syn-mode .b-manu { border-radius: 0 8px 8px 0; border-left: none; }\n.syn-mode button.act { background: #22d3ee; color: #062730; border-color: #22d3ee; }\n.syn-btns { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }\n.syn-btns button { padding: 14px 0; border-radius: 10px; font-size: 16px; font-weight: 800; letter-spacing: 1px; background: transparent; border: 2px solid; transition: background .15s, color .15s, opacity .15s; }\n.syn-btns .b-on { color: #22c55e; border-color: #22c55e; } .syn-btns .b-on:hover:enabled, .syn-btns .b-on.act { background: #22c55e; color: #06240f; }\n.syn-btns .b-off { color: #ef4444; border-color: #ef4444; } .syn-btns .b-off:hover:enabled, .syn-btns .b-off.act { background: #ef4444; color: #2b0606; }\n.b-au { align-self: center; width: 118px; height: 118px; border-radius: 50%; border: 8px solid #facc15; background: radial-gradient(circle at 35% 30%, #ff7b7b, #dc2626 55%, #991b1b); color: #fff; font-size: 12px; font-weight: 900; letter-spacing: .3px; line-height: 1.25; box-shadow: 0 6px 0 #7f1d1d, 0 10px 18px rgba(0,0,0,.5); transition: transform .08s, box-shadow .08s; }\n.b-au span { display: block; white-space: nowrap; }\n.b-au:active:enabled { transform: translateY(5px); box-shadow: 0 1px 0 #7f1d1d, 0 4px 8px rgba(0,0,0,.5); }\n.b-rearm { padding: 16px 0; border-radius: 10px; border: 2px solid #f59e0b; background: transparent; color: #f59e0b; font-size: 15px; font-weight: 800; letter-spacing: 1px; }\n.b-rearm:hover:enabled { background: #f59e0b; color: #2b1a03; }\n</style>",
